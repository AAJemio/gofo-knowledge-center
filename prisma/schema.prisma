generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  agent
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // In a real app, this should be hashed. For this demo, we might store plain or simple hash.
  firstName String   @default("")
  lastName  String   @default("")
  role      Role     @default(agent)
  usageCount Int      @default(0)
  mustChangePassword Boolean @default(false)
  
  // Preferences
  theme       String   @default("light") // 'light' | 'dark'
  language    String   @default("es")    // 'es' | 'en'
  defaultPage String   @default("mqa")   // 'mqa' | '/prompts' | 'last-visited' ...
  lastPath    String   @default("/mqa")
  wapViewMode String   @default("list")  // 'list' | 'grid'

  interactions Interaction[]
  auditLogs    AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
  
  // Relations
  authoredCases     SupportCase[] @relation("AuthoredCases")
  editedCases       SupportCase[] @relation("EditedCases")
  authoredPrompts   WhatsappPrompt[] @relation("AuthoredPrompts")
  editedPrompts     WhatsappPrompt[] @relation("EditedPrompts")
  kpiRecords        DailyKPI[]
  
  // KPI Admin Relations
  kpiActivityLogs   KpiActivityLog[]
  kpiSourceFiles    KpiSourceFile[]
}

model PudoLocation {
  id              String   @id @default(uuid())
  name            String
  address         String
  businessDaysEn  String
  businessDaysEs  String
  businessHours   String
  contact         String
  zipCode         String
  imageUrl        String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  
  // Relation to Prompt (optional)
  whatsappPromptId String?
  whatsappPrompt   WhatsappPrompt? @relation(fields: [whatsappPromptId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PudoContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g., 'intro', 'footer', 'pdf_info'
  contentEn String   @db.Text
  contentEs String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  action    String   // 'CREATE' | 'UPDATE' | 'DELETE'
  entity    String   // 'CASE' | 'PROMPT'
  entityId  String
  details   String   @db.Text
  
  previousState String? @db.Text // JSON snapshot of state before change
  newState      String? @db.Text // JSON snapshot of state after change
  
  isReverted    Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model WhatsappPrompt {
  id            String   @id @default(uuid())
  title         String
  title_es      String?
  category      String
  code_impar_en String?
  code_par_es   String?
  content_en    String   @db.Text
  content_es    String   @db.Text
  usage_count   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  highlightExpiresAt DateTime?
  highlightColor     String? // e.g. '#ffcc00' or 'red'
  highlightReason    String? // Reason for highlighting
  highlightStartsAt  DateTime? // Start of highlight period
  
  supportCases          SupportCase[] // Relation to cases that recommend this prompt
  interactions          Interaction[]
  pudoLocations         PudoLocation[]

  // Relations to User
  authorId      String?
  author        User?   @relation("AuthoredPrompts", fields: [authorId], references: [id])
  editorId      String?
  editor        User?   @relation("EditedPrompts", fields: [editorId], references: [id])
}

model SupportCase {
  id                   String   @id @default(uuid())
  title_es             String
  title_en             String
  category             String
  keywords             String   @db.Text
  condition            String   @db.Text
  condition_en         String?  @db.Text
  crm_code_type        String?
  crm_complaint_status String?
  crm_detailed_type    String?
  crm_remark_template  String?  @db.Text
  script_official_en   String   @db.Text
  script_official_es   String   @db.Text
  script_friendly_en   String?  @db.Text
  script_friendly_es   String?  @db.Text
  usage_count          Int      @default(0)
  
  recommendedPrompts    WhatsappPrompt[]
  interactions          Interaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  highlightExpiresAt DateTime?
  highlightColor     String?
  highlightReason    String?
  highlightStartsAt  DateTime?

  // Relations to User
  authorId      String?
  author        User?   @relation("AuthoredCases", fields: [authorId], references: [id])
  editorId      String?
  editor        User?   @relation("EditedCases", fields: [editorId], references: [id])
}

model Interaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // 'case' | 'prompt'
  language  String?  // 'en' | 'es'
  
  caseId    String?
  case      SupportCase? @relation(fields: [caseId], references: [id])
  
  promptId  String?
  prompt    WhatsappPrompt? @relation(fields: [promptId], references: [id])
  
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // 'CASE_UPDATE' | 'PROMPT_UPDATE'
  entityId  String
  title     String
  message   String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([createdAt])
}


model DailyKPI {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  date            DateTime // Normalized date (midnight)
  
  // Metrics from Excel
  conversations           Int      @default(0)
  outboundMessages        Int      @default(0)
  onlineTimeSeconds       Int      @default(0) // Parsed from "7h 35m"
  availableTimeSeconds    Int      @default(0) // Parsed from "6h 51m"
  firstResponseTimeSeconds Int     @default(0) // Parsed from "31s"
  resolutionTimeSeconds   Int      @default(0) // Parsed from "33m 28s"
  csat                    Float    @default(0.0) // Parsed from "82%"
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model KpiActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String   // 'UPLOAD' | 'DELETE' | 'REVERT' | 'LOCK'
  targetDate DateTime? // For date-specific actions
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model KpiSettings {
  id          String   @id @default("default") // Singleton
  lockDate    DateTime?
  dailyConversationTarget Int @default(100)
  updatedAt   DateTime @updatedAt
}

model KpiSourceFile {
  id          String   @id @default(uuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  filename    String
  uploadDate  DateTime @default(now())
  targetDate  DateTime // The KPI date this file belongs to
  fileData    Bytes    // Storing file directly for simplicity as per requirements (Evidence)
  
  @@index([targetDate])
}

model SystemTempStorage {
  id        String   @id @default(uuid())
  dataType  String   // 'RESTORE_PAYLOAD'
  data      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
}
